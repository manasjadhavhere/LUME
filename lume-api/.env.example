# LUME API — Environment Variables Template
# Copy this file to .env and fill in all values.
# NEVER commit your actual .env file to Git!

# Database (Supabase connection string in production)
DATABASE_URL="postgresql://user:password@host:port/dbname"

# JWT — Use a long random string (min 32 chars). Generate one at: https://generate-secret.vercel.app/32
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=3001
NODE_ENV=production

# CORS — Your frontend domain. For multiple origins, separate with comma.
# Example: CLIENT_URL="https://yourdomain.com,https://www.yourdomain.com"
CLIENT_URL="https://yourdomain.com"

# File Uploads — Max file size in bytes (10MB default)
MAX_FILE_SIZE=10485760

# Cloudinary — Get from: https://console.cloudinary.com -> Dashboard
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Razorpay — Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
