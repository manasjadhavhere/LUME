generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  passwordHash     String
  role             Role           @default(CLIENT)
  name             String
  phone            String?
  gender           Gender?
  dob              DateTime?
  avatarUrl        String?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  artistProfile    ArtistProfile?
  bookingsAsClient Booking[]      @relation("ClientBookings")
  clientProfile    ClientProfile?
  notifications    Notification[]
  reviewsGiven     Review[]       @relation("ClientReviews")

  @@map("users")
}

model ClientProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  location     String?
  mobileNumber String?
  dob          DateTime?
  bio          String?
  aadharNumber String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model ArtistProfile {
  id                      String             @id @default(cuid())
  userId                  String             @unique
  bio                     String?
  gender                  Gender?
  dob                     DateTime?
  location                String             @default("Mumbai")
  experience              Int                @default(0)
  certification           String?
  certificationFiles      String[]           @default([])
  profileImageUrl         String?
  badge                   BadgeType?
  isVerified              Boolean            @default(false)
  verificationStatus      VerificationStatus @default(NOT_SUBMITTED)
  verificationSubmittedAt DateTime?
  isAvailable             Boolean            @default(true)
  rating                  Float              @default(0.0)
  reviewCount             Int                @default(0)
  bookingCount            Int                @default(0)
  totalEarnings           Float              @default(0.0)
  responseRate            Float              @default(100.0)
  completionRate          Float              @default(100.0)
  instagramUrl            String?
  portfolioUrls           String[]           @default([])
  specialties             String[]           @default([])
  weddingPrice            Float?
  occasionPrice           Float?
  hourlyPrice             Float?
  startingPrice           Float              @default(0.0)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  verificationRemarks     String?
  isTakingBookings        Boolean            @default(true)
  lastBookingStatusChange DateTime?
  bankAccount             ArtistBankAccount?
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability            Availability[]
  blockedDates            BlockedDate[]
  bookings                Booking[]          @relation("ArtistBookings")
  defaultSchedule         DefaultSchedule[]
  reviews                 Review[]           @relation("ArtistReviews")
  services                Service[]

  @@map("artist_profiles")
}

model DefaultSchedule {
  id        String        @id @default(cuid())
  artistId  String
  dayOfWeek Int
  timeSlots Json
  artist    ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, dayOfWeek])
  @@map("default_schedules")
}

model Service {
  id          String        @id @default(cuid())
  artistId    String
  name        String
  description String?
  price       Float
  duration    Int
  icon        String        @default("✨")
  isActive    Boolean       @default(true)
  bookings    Booking[]
  artist      ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@map("services")
}

model Availability {
  id        String        @id @default(cuid())
  artistId  String
  date      DateTime      @db.Date
  timeSlots Json
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  artist    ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, date])
  @@map("availability")
}

model BlockedDate {
  id        String        @id @default(cuid())
  artistId  String
  date      DateTime      @db.Date
  reason    String?
  createdAt DateTime      @default(now())
  artist    ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, date])
  @@map("blocked_dates")
}

model Booking {
  id              String          @id @default(cuid())
  clientId        String
  artistId        String
  serviceId       String?
  date            DateTime        @db.Date
  time            String
  endTime         String?
  status          BookingStatus   @default(PENDING)
  priceType       PriceType       @default(OCCASION)
  totalPaid       Float           @default(0)
  notes           String?
  address         String?
  cancelReason    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  paymentType     String?
  advancePaid     Float           @default(0)
  remainingAmount Float           @default(0)
  artist          ArtistProfile   @relation("ArtistBookings", fields: [artistId], references: [id])
  client          User            @relation("ClientBookings", fields: [clientId], references: [id])
  service         Service?        @relation(fields: [serviceId], references: [id])
  paymentRecords  PaymentRecord[]
  review          Review?

  @@map("bookings")
}

model Review {
  id        String        @id @default(cuid())
  bookingId String        @unique
  clientId  String
  artistId  String
  rating    Float
  text      String
  reply     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  artist    ArtistProfile @relation("ArtistReviews", fields: [artistId], references: [id])
  booking   Booking       @relation(fields: [bookingId], references: [id])
  client    User          @relation("ClientReviews", fields: [clientId], references: [id])

  @@map("reviews")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ArtistBankAccount {
  id                      String        @id @default(cuid())
  artistId                String        @unique
  accountHolderName       String
  encryptedAccountNumber  String
  ifscCode                String
  bankName                String
  accountType             String        @default("SAVINGS")
  isVerified              Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  isLinkedToRazorpay      Boolean       @default(false)
  razorpayLinkedAccountId String?
  artist                  ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@map("artist_bank_accounts")
}

model PaymentRecord {
  id                 String       @id @default(cuid())
  bookingId          String
  paymentType        String
  razorpayOrderId    String?
  razorpayPaymentId  String?
  totalCharged       Float
  basePortion        Float
  gstAmount          Float
  lumeCommission     Float
  lumeTotal          Float
  artistPayout       Float
  payoutStatus       PayoutStatus @default(PENDING)
  payoutInitiatedAt  DateTime?
  payoutCompletedAt  DateTime?
  createdAt          DateTime     @default(now())
  razorpayTransferId String?
  transferStatus     String       @default("PENDING")
  booking            Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payment_records")
}

enum Role {
  CLIENT
  ARTIST
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  ACCEPTED
  PARTIALLY_PAID
}

enum PayoutStatus {
  PENDING
  INITIATED
  COMPLETED
  FAILED
}

enum PriceType {
  WEDDING
  OCCASION
  HOURLY
}

enum BadgeType {
  TOP_PICK
  NEW
  VERIFIED
  FEATURED
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
  EDIT_REQUESTED
  EDIT_APPROVED
}
